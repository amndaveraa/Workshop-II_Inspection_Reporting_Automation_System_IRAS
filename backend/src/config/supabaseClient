import { createClient } from '@supabase/supabase-js';
import dotenv from 'dotenv';

dotenv.config();

const supabaseUrl = process.env.SUPABASE_URL;
const supabaseServiceKey = process.env.SUPABASE_SERVICE_ROLE_KEY || process.env.SUPABASE_ANON_KEY;

console.log('Current directory:', process.cwd());
console.log('Supabase URL found:', !!supabaseUrl);
console.log('Service Key found:', !!supabaseServiceKey);
// console.log('All Env Keys:', Object.keys(process.env).filter(k => k.startsWith('SUPA')));

if (!supabaseUrl || !supabaseServiceKey) {
  // Warn but don't crash immediately? No, client needs a key.
  console.error('CRITICAL: Supabase URL or Key is missing.');
  // We can let it throw, but now we have a fallback.
  throw new Error('Supabase URL or Key (Service Role or Anon) is missing.');
}

if (!process.env.SUPABASE_SERVICE_ROLE_KEY) {
    console.warn("⚠️ WARNING: Using SUPABASE_ANON_KEY. Some admin actions may fail RLS policies.");
}

// The service_role key allows the backend to bypass RLS policies
const supabase = createClient(supabaseUrl, supabaseServiceKey, {
  auth: {
    autoRefreshToken: false,
    persistSession: false
  }
});

export default supabase;
